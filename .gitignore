# ─────────────────────────────────────────────
# Eclipse IDE workspace metadata (Spring Tools Suite / Eclipse)
# ─────────────────────────────────────────────
**/.metadata/
**/.apt_generated
**/.classpath
**/.factorypath
**/.project
**/.settings/
**/.springBeans
**/.sts4-cache
**/.gitattributes

# ─────────────────────────────────────────────
# Maven build output
# ─────────────────────────────────────────────
**/target/
**/.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ─────────────────────────────────────────────
# Python bytecode & cache
# ─────────────────────────────────────────────
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
**/.Python
**/env/
**/venv/
**/.venv/
**/*.egg-info/
**/.pytest_cache/

# ─────────────────────────────────────────────
# Node / Frontend
# ─────────────────────────────────────────────
**/node_modules/
**/dist/
**/dist-ssr/
**/*.local
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# ─────────────────────────────────────────────
# IntelliJ IDEA
# ─────────────────────────────────────────────
**/.idea/
**/*.iws
**/*.iml
**/*.ipr

# ─────────────────────────────────────────────
# VS Code (keep extensions.json)
# ─────────────────────────────────────────────
**/.vscode/*
!**/.vscode/extensions.json

# ─────────────────────────────────────────────
# OS generated files
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─────────────────────────────────────────────
# Sensitive / local config (never commit!)
# ─────────────────────────────────────────────
# Real config files with DB credentials – NEVER commit these.
# Use application.properties.example as a safe template for collaborators.
**/application.properties
# Exception: the production-safe version reads from env vars — safe to commit
!**/src/main/resources/application.properties
**/application-local.properties
**/.env
**/.env.local

# ─────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────
logs/
*.log
.vercel
.vercel-cli
